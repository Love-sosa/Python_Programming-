# Concession stand program

# dictionary {key:value}

menu = {"popcorn":1.00,
               "hotdog":2.00,
               "giant pretzel":2.00,
               "asst candy":1.00,
               "soda":1.00,
               "bottled water":1.00}

cart = []
total = 0

print("-------------MENU---------------")
for key, value in menu.items():
    total = total + value
for key, value in menu.items():
    print(f"{key:15}: ${value:.2f}")
print("--------------------------------")

while True:
    food = input("Select an item(q to quit):").lower()
    if food == "q":
        break
    elif menu.get(food) is not None:
        cart.append(food)
print()

print("----------YOUR ORDER----------")
for food in cart:
     total += menu.get(food)
     print(food)

print()
print(f"Total is: ${total:.2f}")
