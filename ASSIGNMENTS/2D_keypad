# xxx          A two Dimensional keypad    xxxxxxxxx

num_1 =      ("1", "2" , "3")
num_2 =      ("4", "5", "6")
num_3 =      ("7", "8", "9")
symbol_num = ("*", "0", "#")

keypad = (num_1, num_2, num_3, symbol_num)

for row in keypad:
    for num in row:
        print(num, end=" ")
    print()
