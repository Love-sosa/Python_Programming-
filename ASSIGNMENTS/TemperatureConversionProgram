unit = input("Enter the unit of Temperature in Fahrenheit or Celsius: (F/C):")

if unit == "C":
    temp = round((temp * 9 / 5) + 32, 1)
    unit = "F"
    print(f"The temperature is:{temp}{unit}")
elif unit == "F":
    temp = round((temp - 32) * 5 / 9, 1)
    unit = "C"
    print(f"The temperature:{temp}{unit}")
else:
    print(f"{unit} isn't a valid unit of measurement")
