#while loop = execute some code WHILE some condition remains true

# While loop is very useful for verifying user-input
# if a user types some user input which is not valid, you can re-prompt them. 


name = input("What is your name? ")

while name == "":
    print("You didn't enter a name.")
    name = input("What is your name? ")
print(f"Hello, {name}")


